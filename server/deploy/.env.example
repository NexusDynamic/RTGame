# Public hostname; Caddy gets a certificate for it automatically.
DOMAIN=play.example.com
# The VPS's public IPv4, for coturn.
PUBLIC_IP=203.0.113.10

# Generate each with: openssl rand -base64 48
LOBBY_SIGNING_KEY=
TURN_SECRET=

# TURN. With an existing coturn: set TURN_HOST/TURN_PORT to it, TURN_SECRET to
# its static-auth-secret, and start without `--profile turn`.
# With this compose file's coturn: `docker compose --profile turn up -d`.
#TURN_HOST=turn.example.com
#TURN_PORT=3478
#TURN_MIN_PORT=49160
#TURN_MAX_PORT=49400

# Optional
POW_DIFFICULTY=17
MAX_ROOMS=200
